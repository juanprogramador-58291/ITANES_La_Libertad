<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="32dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.45" />

            <!-- Columna Izquierda: Imagen y Acciones Rápidas -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardImageDetail"
                android:layout_width="0dp"
                android:layout_height="400dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imageDetailPlace"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:contentDescription="@string/detail_title" />

                    <ImageButton
                        android:id="@+id/btnDetailBack"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_margin="16dp"
                        android:background="@drawable/bg_circular_control"
                        android:contentDescription="@string/btn_back_description"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_revert"
                        app:tint="@color/white" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="@+id/cardImageDetail"
                app:layout_constraintStart_toStartOf="@+id/cardImageDetail"
                app:layout_constraintTop_toBottomOf="@+id/cardImageDetail">

                <ImageButton
                    android:id="@+id/buttonFavorite"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circular_control"
                    android:contentDescription="@string/btn_favorite"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_favorite"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/buttonShare"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_circular_control"
                    android:contentDescription="@string/btn_share"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_share"
                    app:tint="@color/white" />
            </LinearLayout>

            <!-- Columna Derecha: Información y Botones de Mapa -->
            <TextView
                android:id="@+id/textDetailName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:textColor="@color/color_primary"
                android:textSize="36sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textDetailShortDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:textStyle="italic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
                app:layout_constraintTop_toBottomOf="@+id/textDetailName" />

            <TextView
                android:id="@+id/textDetailDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="24dp"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:lineSpacingMultiplier="1.3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
                app:layout_constraintTop_toBottomOf="@+id/textDetailShortDescription" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonViewMap"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="40dp"
                android:text="@string/btn_view_map"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/color_primary"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_place"
                app:iconTint="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
                app:layout_constraintTop_toBottomOf="@+id/textDetailDescription" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGetDirections"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="40dp"
                android:text="@string/btn_get_directions"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/color_primary_dark"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_directions"
                app:iconTint="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
                app:layout_constraintTop_toBottomOf="@+id/buttonViewMap"
                app:layout_constraintVertical_bias="0.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Bottom Navigation View -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:background="@color/color_nav_bg"
        app:itemIconTint="@drawable/nav_item_color_state"
        app:itemTextColor="@drawable/nav_item_color_state"
        app:itemActiveIndicatorStyle="@style/App.CustomIndicator"
        app:elevation="8dp"
        app:menu="@menu/bottom_navigation_menu"
        app:labelVisibilityMode="labeled" />

</RelativeLayout>
